// Approved Plant, Equipment inventory and energy history schema. Custom constraints live in migrations.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PlantStatus {
  GROWING
  QUARANTINE
  SOLD
  DECEASED
}

model Plant {
  id         String      @id @default(uuid()) @db.Uuid
  reference  String      @unique
  name       String?
  status     PlantStatus @default(GROWING)
  locationId String?     @db.Uuid
  notes      String?
  createdAt  DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime    @updatedAt @db.Timestamptz(3)
  archivedAt DateTime?   @db.Timestamptz(3)

  location                Location?        @relation(fields: [locationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  parentage               PlantParentage?  @relation("PlantParentage")
  purchase                PlantPurchase?
  photos                  PlantPhoto[]
  offspringAsSeedParent   PlantParentage[] @relation("SeedParent")
  offspringAsPollenParent PlantParentage[] @relation("PollenParent")

  @@index([locationId])
}

model PlantParentage {
  id                  String   @id @default(uuid()) @db.Uuid
  plantId             String   @unique @db.Uuid
  seedParentPlantId   String?  @db.Uuid
  seedParentName      String?
  pollenParentPlantId String?  @db.Uuid
  pollenParentName    String?
  createdAt           DateTime @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime @updatedAt @db.Timestamptz(3)

  plant        Plant  @relation("PlantParentage", fields: [plantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  seedParent   Plant? @relation("SeedParent", fields: [seedParentPlantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  pollenParent Plant? @relation("PollenParent", fields: [pollenParentPlantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([seedParentPlantId])
  @@index([pollenParentPlantId])
}

model PlantPurchase {
  id                String    @id @default(uuid()) @db.Uuid
  plantId           String    @unique @db.Uuid
  seller            String?
  orderReference    String?
  purchaseDate      DateTime? @db.Date
  // Nonnegative cost checks are defined in the init_plant_management migration.
  plantPriceMinor   Int?
  shippingCostMinor Int?
  otherCostMinor    Int?
  currency          String    @default("GBP") @db.VarChar(3)
  createdAt         DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @db.Timestamptz(3)

  plant Plant @relation(fields: [plantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
}

model PlantPhoto {
  id                 String    @id @default(uuid()) @db.Uuid
  plantId            String    @db.Uuid
  storageKey         String    @unique
  originalFilename   String?
  caption            String?
  takenAt            DateTime? @db.Timestamptz(3)
  isPrimary          Boolean   @default(false)
  sortOrder          Int       @default(0)
  // All-or-none crop metadata and ranges are enforced by migration checks.
  cropX              Float?    @db.DoublePrecision
  cropY              Float?    @db.DoublePrecision
  cropSize           Float?    @db.DoublePrecision
  derivativeRevision String?   @db.Uuid
  createdAt          DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @db.Timestamptz(3)

  plant Plant @relation(fields: [plantId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([plantId, sortOrder])
}

model Equipment {
  id           String    @id @default(uuid()) @db.Uuid
  reference    String    @unique
  name         String
  category     String    @default("Other")
  brand        String?
  model        String?
  serialNumber String?
  notes        String?
  // Capable of having electrical consumption tracked, not current operating state.
  usesPower    Boolean
  locationId   String?   @db.Uuid
  archivedAt   DateTime? @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(3)

  location     Location?              @relation(fields: [locationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  purchase     EquipmentPurchase?
  powerPeriods EquipmentPowerPeriod[]
  photos       EquipmentPhoto[]

  @@index([locationId])
}

model EquipmentPhoto {
  id                 String    @id @default(uuid()) @db.Uuid
  equipmentId        String    @db.Uuid
  storageKey         String    @unique
  originalFilename   String?
  caption            String?
  takenAt            DateTime? @db.Timestamptz(3)
  isPrimary          Boolean   @default(false)
  sortOrder          Int       @default(0)
  // All-or-none crop metadata and ranges are enforced by migration checks.
  cropX              Float?    @db.DoublePrecision
  cropY              Float?    @db.DoublePrecision
  cropSize           Float?    @db.DoublePrecision
  derivativeRevision String?   @db.Uuid
  createdAt          DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @db.Timestamptz(3)

  equipment Equipment @relation(fields: [equipmentId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([equipmentId, sortOrder])
}

model EquipmentPurchase {
  id                  String    @id @default(uuid()) @db.Uuid
  equipmentId         String    @unique @db.Uuid
  seller              String?
  orderReference      String?
  purchaseDate        DateTime? @db.Date
  // Nonnegative cost checks are defined in the init_equipment_inventory migration.
  equipmentPriceMinor Int?
  // Shipping allocated to this item, not automatically the total for a shared order.
  shippingCostMinor   Int?
  otherCostMinor      Int?
  currency            String    @default("GBP") @db.VarChar(3)
  createdAt           DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime  @updatedAt @db.Timestamptz(3)

  equipment Equipment @relation(fields: [equipmentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
}

// Bounds, interval validity, void reasons and nonvoid overlap protection are migration SQL.
model EquipmentPowerPeriod {
  id               String    @id @default(uuid()) @db.Uuid
  equipmentId      String    @db.Uuid
  powerWatts       Decimal   @db.Decimal(8, 2)
  hoursPerDay      Decimal   @db.Decimal(4, 2)
  effectiveFrom    DateTime  @db.Date
  effectiveTo      DateTime? @db.Date
  notes            String?
  correctionReason String?
  voidedAt         DateTime? @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @db.Timestamptz(3)

  equipment Equipment @relation(fields: [equipmentId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([equipmentId, effectiveFrom])
}

// One nursery tariff timeline. GBP minor units are pence per kWh, not whole purchase pence.
model ElectricityTariff {
  id                  String    @id @default(uuid()) @db.Uuid
  unitRateMinorPerKwh Decimal   @db.Decimal(9, 5)
  currency            String    @default("GBP") @db.VarChar(3)
  effectiveFrom       DateTime  @db.Date
  effectiveTo         DateTime? @db.Date
  notes               String?
  correctionReason    String?
  voidedAt            DateTime? @db.Timestamptz(3)
  createdAt           DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime  @updatedAt @db.Timestamptz(3)
}

model Location {
  id               String    @id @default(uuid()) @db.Uuid
  name             String
  description      String?
  parentLocationId String?   @db.Uuid
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @db.Timestamptz(3)
  archivedAt       DateTime? @db.Timestamptz(3)

  plants         Plant[]
  equipment      Equipment[]
  parentLocation Location?   @relation("LocationHierarchy", fields: [parentLocationId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  childLocations Location[]  @relation("LocationHierarchy")

  // The migration adds NULLS NOT DISTINCT so root names are unique too.
  @@unique([parentLocationId, name])
}
