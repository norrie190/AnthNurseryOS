# Local PostgreSQL container settings. These values are for development only.
POSTGRES_USER="anth_nursery"
POSTGRES_PASSWORD="anth_nursery_local"
POSTGRES_DB="anth_nursery"
POSTGRES_PORT="5432"

# Prisma connection strings for the development and test databases.
DATABASE_URL="postgresql://anth_nursery:anth_nursery_local@localhost:5432/anth_nursery?schema=public"
TEST_DATABASE_URL="postgresql://anth_nursery:anth_nursery_local@localhost:5432/anth_nursery_test?schema=public"
